# ============================================================
#  agent-dual-machine 环境变量示例
#
#  推荐用法（密钥不落盘）：
#    1) 复制成主控端的 vault：~/.secrets/qq-bridge.env（放在项目目录之外），填好真实值
#    2) node scripts/secrets.mjs push --host user@host
#       → 加密钥到算力端 /run/user/<uid>/qq-bridge.env（tmpfs，600）
#    3) 机器重启后 tmpfs 清空，靠 systemd 的 EnvironmentFile 缺失让 unit failed，
#       需要重新 push 一次才上线（这就是"每次都要显式授权"）
#
#  也可以 export 到当前 shell 做临时调试。
#  真实值绝对不要提交进仓库，也不要放进项目目录。
# ============================================================

# ---- OneBot / QQ 连接（必填）----
# SnowLuma / go-cqhttp 之类 OneBot 实现的 WebSocket 地址
ONEBOT_WS=ws://127.0.0.1:3001
# 如果 OneBot 设了 access_token，填这里；没有就留空
ONEBOT_TOKEN=

# ---- Ollama 本地模型（必填）----
OLLAMA_URL=http://127.0.0.1:11434
# 必须选一个能稳定跑 4096 上下文的模型
MODEL=qwen3.5:4b-chat

# ---- 人设覆盖（可选）----
# 设了会覆盖 config.json 里的 system，一般留空，改配置文件更直观
SYSTEM=

# ---- 联网搜索（可选）----
# 二选一；都不填则搜索降级为免费抓取（bing/ddg），速度慢且容易被反爬
TAVILY_API_KEY=
BOCHA_API_KEY=

# ---- 云端模型（可选，仅 D 档需要）----
DEEPSEEK_API_KEY=

# ---- 运行调试（可选）----
# 换一份配置文件，用于 A/B 调参而不动真实配置
BRIDGE_CONFIG=
# 置 1 则只打印不发送（测试轨道专用）
SHADOW=
# 置 1 则打印锁竞争的详细信息
BRIDGE_DEBUG_LOCK=

# ---- B 档（btask）调参（可选）----
BTASK_PROVIDER=
BTASK_WARM_MODEL=
BTASK_NO_REWARM=

# ---- C 档（DSH headless）（可选）----
DSH_BIN=
DSH_PROFILE=
TASK_TIMEOUT_MS=
