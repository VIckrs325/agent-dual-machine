// ============================================================
// 阶段一：OpenClaw 云端 DeepSeek API 版配置
// 部署位置：2060 本 ~/.openclaw/openclaw.json
// 说明：DeepSeek 走 OpenAI 兼容协议，api 字段必填，勿删。
// ============================================================
{
  // 环境变量（密钥用 ${VAR} 引用，避免明文写死）
  env: {
    DEEPSEEK_API_KEY: "sk-REPLACE_ME", // TODO: 替换为真实 DeepSeek 密钥
  },

  models: {
    mode: "merge", // 保留内置 provider，只追加自定义项
    providers: {
      deepseek: {
        baseUrl: "https://api.deepseek.com/v1",
        apiKey: "${DEEPSEEK_API_KEY}",
        api: "openai-completions", // 必填，漏掉会报 "No API provider registered"
        timeoutSeconds: 120,
        models: [
          {
            id: "deepseek-chat",
            name: "DeepSeek-V3 (deepseek-chat)",
            contextWindow: 128000,
            maxTokens: 8192,
            reasoning: false,
            inputTypes: ["text"],
          },
        ],
      },
    },
  },

  agents: {
    defaults: {
      model: {
        primary: "deepseek/deepseek-chat",
      },
      // 沙箱：阶段一先用 non-main 保底，工程任务走 DSH 沙箱
      sandbox: {
        mode: "non-main",
        scope: "session",
        workspaceAccess: "rw",
      },
    },
  },
}
